# Mẫu biến môi trường cho harness 2 user (scripts/rls_two_user_harness.mjs).
# Sao chép thành .env.test.local (đã bị .gitignore chặn qua mẫu .env*) rồi điền giá trị.
# CHỈ dùng Supabase project TEST, KHÔNG BAO GIỜ dùng project production.
# KHÔNG đặt service_role key ở đây - harness chỉ cần anon key + mật khẩu 2 user test.
TEST_SUPABASE_URL=https://<test-project-ref>.supabase.co
TEST_SUPABASE_ANON_KEY=<anon-public-key-of-TEST-project>
TEST_USER_A_EMAIL=user-a@example.test
TEST_USER_A_PASSWORD=<password-user-a>
TEST_USER_B_EMAIL=user-b@example.test
TEST_USER_B_PASSWORD=<password-user-b>
