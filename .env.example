# TradeNote app environment template. Copy to .env.local and fill in.
# Placeholders only - never commit real values.

# Supabase (browser client + AI Coach route)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional fallback used by src/app/api/ai-coach/route.ts when NEXT_PUBLIC_* is unset
SUPABASE_URL=
SUPABASE_ANON_KEY=

# AI Coach (OpenRouter) - server-side only
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=

# --- Script-only (scripts/p3_prod_apply.mjs). Do NOT put these in .env.local; ---
# --- export them in your shell only when running that script.               ---
# PROD_DB_URL=postgresql://user:password@host:5432/postgres
# PG_MODULE_PATH=<absolute path to an installed "pg" package directory>
