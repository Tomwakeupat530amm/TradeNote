    { "name": "17:00 ET summer 16:59", "instant": "2026-07-14T20:59:00Z", "userTz": "UTC", "override": { "resetTime": "17:00", "resetTz": "America/New_York" }, "expected": "2026-07-13" },
    { "name": "17:00 ET summer 17:00", "instant": "2026-07-14T21:00:00Z", "userTz": "UTC", "override": { "resetTime": "17:00", "resetTz": "America/New_York" }, "expected": "2026-07-14" },
    { "name": "day before spring-forward 17:00 EST", "instant": "2026-03-07T22:00:00Z", "userTz": "UTC", "override": { "resetTime": "17:00", "resetTz": "America/New_York" }, "expected": "2026-03-07" },
    { "name": "spring-forward 2026-03-08 16:59 EDT", "instant": "2026-03-08T20:59:00Z", "userTz": "UTC", "override": { "resetTime": "17:00", "resetTz": "America/New_York" }, "expected": "2026-03-07" },
    { "name": "spring-forward 2026-03-08 17:00 EDT", "instant": "2026-03-08T21:00:00Z", "userTz": "UTC", "override": { "resetTime": "17:00", "resetTz": "America/New_York" }, "expected": "2026-03-08" },
    { "name": "fall-back 2026-11-01 16:00 EST (would be 17:00 EDT)", "instant": "2026-11-01T21:00:00Z", "userTz": "UTC", "override": { "resetTime": "17:00", "resetTz": "America/New_York" }, "expected": "2026-10-31" },
